# Optional local executable overrides. Leave these commented when the command
# is available through PATH. Use absolute paths when it is not. Do not commit
# your real .env file.
# WEBMCPIFY_ANTIGRAVITY_BIN=/absolute/path/to/agy
# WEBMCPIFY_CLAUDE_BIN=/absolute/path/to/claude
# WEBMCPIFY_CODEX_BIN=/absolute/path/to/codex
# WEBMCPIFY_GEMINI_BIN=/absolute/path/to/gemini
# WEBMCPIFY_OPENCODE_BIN=/absolute/path/to/opencode

# Core auto-detects an installed provider. Set this only to choose one.
# WEBMCPIFY_PROVIDER=codex

# The normal workflow defaults to this URL and manages isolated Chrome.
# WEBMCPIFY_URL=http://localhost:3000
# WEBMCPIFY_CHROME_BIN=/absolute/path/to/google-chrome
# WEBMCPIFY_CDP_URL=http://127.0.0.1:9222

# Antigravity headless timeout.
WEBMCPIFY_ANTIGRAVITY_TIMEOUT=15m

# Optional Temporal settings for `repair --durable` and the worker.
# WEBMCPIFY_DURABLE=true
# WEBMCPIFY_TEMPORAL_ADDRESS=localhost:7233
# WEBMCPIFY_TEMPORAL_NAMESPACE=default
# WEBMCPIFY_TEMPORAL_TASK_QUEUE=webmcpify
